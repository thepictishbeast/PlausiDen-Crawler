[Unit]
Description=Lighthouse page-performance audit -> analytics.plausiden.com
Documentation=https://github.com/thepictishbeast/PlausiDen-Crawler
After=network-online.target
Wants=network-online.target

[Service]
# Pinned to Node 22, deliberately.
#
# Debian 13 ships Node 20 and lighthouse@13 declares engines >=22.19.
# Three insight audits use ES2025 iterator helpers Node 20 lacks and
# returned scoreDisplayMode "error" on EVERY run — measured, both
# versions, against a live page.
#
# Installed alongside rather than replacing the system node, because
# ermine-stagenet.service and plausiden-crawler.service both run on
# /usr/bin/node and upgrading underneath them is not this job's business.
Environment=PATH=/opt/node22/bin:/usr/local/bin:/usr/bin:/bin
Type=oneshot
User=paul
Group=paul
WorkingDirectory=/home/paul/projects/PlausiDen-Crawler
ExecStart=/opt/node22/bin/npm run --silent audit:lighthouse -- --targets journeys/lighthouse-targets.json --out /var/lib/plausiden-analytics/ux-inbox
TimeoutStartSec=1800
Nice=19
IOSchedulingClass=idle

# /tmp is noexec on this host, and Chromium unpacks helpers into TMPDIR.
# PrivateTmp=yes would add a second layer of the same problem, so it is
# deliberately absent and TMPDIR points at a filesystem that allows exec.
Environment=TMPDIR=/tank/scratch/uxaudit/tmp

NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/plausiden-analytics/ux-inbox /tank/scratch/uxaudit

# Three hardening directives that other units on this host carry are
# deliberately NOT here, because each one breaks this job in a way that
# looks like a Lighthouse bug rather than a unit-file bug:
#
#   ProtectHome=          hides /home/paul/projects/PlausiDen-Crawler/node_modules
#                         and ~/.cache/ms-playwright, so neither Lighthouse
#                         nor Chromium can be found at all.
#   RestrictAddressFamilies=  emptied (as in the seo unit) blocks every socket,
#                         and Chromium cannot reach the target.
#   MemoryDenyWriteExecute=yes  a JIT engine cannot start under it.

# Keep 30 days of raw Lighthouse reports and no more.
#
# Each run writes a full LHR (~1.3MB); unbounded that is ~470MB/year per
# target and nobody would notice until /tank filled. 30 days is long
# enough to diff a regression against, which is the only reason to keep
# them at all.
#
# `-` prefix: a failed prune must not mark the audit run failed. The
# audit is the point; housekeeping is not.
ExecStartPost=-/usr/bin/find /tank/scratch/uxaudit -type f -mtime +30 -delete

[Install]
WantedBy=multi-user.target
