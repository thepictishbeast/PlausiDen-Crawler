{
  "name": "sacred-vote-voter",
  "description": "Authenticated voter sweep — uses an auth-seed produced by scripts/seed-auth.sh voter. The seed enables an init script that auto-fills the voter-ID gatekeeper with the built-in TEST code, so /voting-app, /dashboard, and /verify-identity all boot past the gatekeeper. TEST mode is built into the server (server/routes/polls.ts:55) so no fake voter rows touch the prod database.",
  "baseUrl": "https://sacred.vote",
  "storageState": "/home/admin/.secure/sacred-vote-voter-state.json",
  "steps": [
    { "kind": "goto", "url": "https://sacred.vote/", "timeout": 30000, "label": "voter-landing" },
    { "kind": "wait", "ms": 3000, "label": "auto-gatekeeper-settle" },
    { "kind": "screenshot", "label": "01-voter-home-authed" },
    { "kind": "goto", "url": "https://sacred.vote/dashboard", "timeout": 30000, "label": "voter-dashboard" },
    { "kind": "wait", "ms": 3000, "label": "auto-gatekeeper-settle" },
    { "kind": "screenshot", "label": "02-dashboard" },
    { "kind": "goto", "url": "https://sacred.vote/verify-identity", "timeout": 30000, "label": "verify-identity" },
    { "kind": "wait", "ms": 3000, "label": "auto-gatekeeper-settle" },
    { "kind": "screenshot", "label": "03-verify-identity" },
    { "kind": "discover", "label": "voter-discover", "url": "https://sacred.vote/", "discover": { "maxPages": 60, "maxDepth": 4, "sameOrigin": true, "interactButtons": "safe-buttons", "denyPatterns": ["/admin"], "settleMs": 1800 } }
  ]
}
