{
  "name": "plausiden-smoke-dark",
  "description": "Desktop dark-theme variant of plausiden-smoke. Same landing → sidebar → every-view → admin sequence at 1280x900 with prefers-color-scheme: dark emulated pre-navigation, so initial paint is dark (no flash-of-light-theme). Part of the 24-combo Forge test matrix (3 themes × 2 viewports × 2 modes × 2 debug). To exercise the AMOLED dark variant on a site that ships a separate dark-amoled token set, copy this file to plausiden-smoke-dark-amoled.json and set `theme: \"dark-amoled\"`.",
  "baseUrl": "http://10.99.0.3:3000/",
  "viewport": { "w": 1280, "h": 900 },
  "colorScheme": "dark",
  "theme": "dark",
  "steps": [
    { "kind": "goto", "url": "http://10.99.0.3:3000/", "timeout": 30000, "label": "landing" },
    { "kind": "wait", "ms": 2000, "label": "settle" },
    { "kind": "click", "selector": "button:has-text('I accept')", "timeout": 4000, "label": "accept-tos" },
    { "kind": "wait", "ms": 300 },
    { "kind": "click", "selector": "button:has-text('Get started')", "timeout": 3000, "label": "dismiss-welcome-click" },
    { "kind": "wait", "ms": 300 },
    { "kind": "press", "key": "Escape", "label": "dismiss-any-overlay" },
    { "kind": "wait", "ms": 200 },
    { "kind": "press", "key": "Escape", "label": "dismiss-welcome-too" },
    { "kind": "wait", "ms": 200 },
    { "kind": "screenshot", "label": "01-landing-dark" },
    { "kind": "click", "selector": "[data-tour='chats-toggle']", "label": "toggle-sidebar", "timeout": 3000 },
    { "kind": "wait", "ms": 500 },
    { "kind": "click", "selector": "[data-tour='chats-toggle']", "label": "toggle-sidebar-close", "timeout": 3000 },
    { "kind": "press", "key": "Control+Shift+KeyB", "label": "cmd-b-via-kbd" },
    { "kind": "wait", "ms": 500 },
    { "kind": "screenshot", "label": "02-post-sidebar-dark" },
    { "kind": "press", "key": "Control+2", "label": "jump-classroom" },
    { "kind": "wait", "ms": 1500 },
    { "kind": "screenshot", "label": "03-classroom-dark" },
    { "kind": "press", "key": "Control+4", "label": "jump-fleet" },
    { "kind": "wait", "ms": 1500 },
    { "kind": "screenshot", "label": "04-fleet-dark" },
    { "kind": "press", "key": "Control+5", "label": "jump-library" },
    { "kind": "wait", "ms": 1500 },
    { "kind": "screenshot", "label": "05-library-dark" },
    { "kind": "press", "key": "Control+6", "label": "jump-auditorium" },
    { "kind": "wait", "ms": 1500 },
    { "kind": "screenshot", "label": "06-auditorium-dark" },
    { "kind": "press", "key": "Control+3", "label": "open-admin" },
    { "kind": "wait", "ms": 2000 },
    { "kind": "screenshot", "label": "07-admin-dark" },
    { "kind": "press", "key": "Escape", "label": "close-admin" },
    { "kind": "wait", "ms": 500 },
    { "kind": "press", "key": "Control+1", "label": "back-to-chat" },
    { "kind": "wait", "ms": 500 },
    { "kind": "screenshot", "label": "08-final-dark" }
  ]
}
