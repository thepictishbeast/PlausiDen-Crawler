    { "kind": "wait", "ms": 600 },
    { "kind": "screenshot", "label": "25-admin-diag" },
    { "kind": "press", "key": "ArrowRight", "label": "adm-tab-11" },
    { "kind": "wait", "ms": 2500 },
    { "kind": "screenshot", "label": "26-admin-docs" },
    { "kind": "press", "key": "Escape", "label": "close-admin" },
    { "kind": "wait", "ms": 500 },
    { "kind": "press", "key": "Control+1", "label": "back-to-chat" },
