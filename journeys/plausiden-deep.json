    { "kind": "press", "key": "ArrowRight", "label": "cls-tab-10" },
    { "kind": "wait", "ms": 800 },
    { "kind": "screenshot", "label": "10-classroom-ledger" },
    { "kind": "press", "key": "ArrowRight", "label": "cls-tab-11" },
    { "kind": "wait", "ms": 800 },
    { "kind": "screenshot", "label": "11-classroom-drift" },
    { "kind": "press", "key": "ArrowRight", "label": "cls-tab-12" },
    { "kind": "wait", "ms": 800 },
    { "kind": "screenshot", "label": "12-classroom-runs" },

    { "kind": "press", "key": "Control+4", "label": "goto-fleet" },
    { "kind": "wait", "ms": 2000 },
    { "kind": "screenshot", "label": "13-fleet" },
    { "kind": "press", "key": "Control+5", "label": "goto-library" },
    { "kind": "wait", "ms": 2000 },
    { "kind": "screenshot", "label": "14-library" },
