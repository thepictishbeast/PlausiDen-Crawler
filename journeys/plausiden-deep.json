{
  "name": "plausiden-deep",
  "description": "Deep audit: visit every Classroom sub-tab, every Admin sub-tab, open every modal. Intended to surface render errors, empty states without data, layout overflows, and dead endpoints that the surface-level smoke misses.",
  "baseUrl": "http://10.99.0.3:3000/",
  "steps": [
    { "kind": "goto", "url": "http://10.99.0.3:3000/", "timeout": 20000, "label": "landing" },
    { "kind": "wait", "ms": 2500, "label": "settle" },
    { "kind": "click", "selector": "button:has-text('I accept')", "timeout": 5000, "label": "accept-tos" },
    { "kind": "wait", "ms": 400 },
    { "kind": "click", "selector": "button:has-text('Get started')", "timeout": 4000, "label": "dismiss-welcome-click" },
    { "kind": "wait", "ms": 400 },
    { "kind": "press", "key": "Escape", "label": "dismiss-welcome" },
    { "kind": "wait", "ms": 300 },
    { "kind": "press", "key": "Escape", "label": "dismiss-tour" },
    { "kind": "wait", "ms": 300 },
    { "kind": "screenshot", "label": "00-chat-landing" },

    { "kind": "press", "key": "Control+2", "label": "goto-classroom" },
    { "kind": "waitForSelector", "selector": "[role='tablist'][aria-label='Classroom sections']", "timeout": 5000, "label": "wait-classroom-tabs" },
    { "kind": "screenshot", "label": "01-classroom-profile" },
    { "kind": "press", "key": "ArrowRight", "label": "cls-tab-2" },
    { "kind": "wait", "ms": 600 },
    { "kind": "screenshot", "label": "02-classroom-ingestion" },
    { "kind": "press", "key": "ArrowRight", "label": "cls-tab-3" },
    { "kind": "wait", "ms": 600 },
    { "kind": "screenshot", "label": "03-classroom-curriculum" },
    { "kind": "press", "key": "ArrowRight", "label": "cls-tab-4" },
    { "kind": "wait", "ms": 600 },
    { "kind": "screenshot", "label": "04-classroom-gradebook" },
    { "kind": "press", "key": "ArrowRight", "label": "cls-tab-5" },
    { "kind": "wait", "ms": 600 },
    { "kind": "screenshot", "label": "05-classroom-lessons" },
    { "kind": "press", "key": "ArrowRight", "label": "cls-tab-6" },
    { "kind": "wait", "ms": 600 },
    { "kind": "screenshot", "label": "06-classroom-tests" },
    { "kind": "press", "key": "ArrowRight", "label": "cls-tab-7" },
    { "kind": "wait", "ms": 600 },
    { "kind": "screenshot", "label": "07-classroom-reports" },
    { "kind": "press", "key": "ArrowRight", "label": "cls-tab-8" },
