{
  "name": "plausiden-smoke-mobile",
  "description": "Mobile variant of plausiden-smoke. Runs the same landing → sidebar → every-view → admin → back sequence at iPhone SE viewport (375×667) to catch the mobile-only layout + touch-target bugs that the desktop journey misses.",
  "baseUrl": "http://10.99.0.3:3000/",
  "viewport": { "w": 375, "h": 667 },
  "steps": [
    { "kind": "goto", "url": "http://10.99.0.3:3000/", "timeout": 30000, "label": "landing" },
    { "kind": "wait", "ms": 2000, "label": "settle" },
    { "kind": "click", "selector": "button:has-text('I accept')", "timeout": 4000, "label": "accept-tos" },
    { "kind": "wait", "ms": 300 },
    { "kind": "click", "selector": "button:has-text('Get started')", "timeout": 3000, "label": "dismiss-welcome-click" },
    { "kind": "wait", "ms": 300 },
    { "kind": "press", "key": "Escape", "label": "dismiss-any-overlay" },
    { "kind": "wait", "ms": 200 },
    { "kind": "press", "key": "Escape", "label": "dismiss-welcome-too" },
    { "kind": "wait", "ms": 200 },
    { "kind": "screenshot", "label": "01-landing-mobile" },
    { "kind": "press", "key": "Control+2", "label": "jump-classroom" },
    { "kind": "wait", "ms": 1500 },
    { "kind": "screenshot", "label": "02-classroom-mobile" },
    { "kind": "press", "key": "Control+4", "label": "jump-fleet" },
    { "kind": "wait", "ms": 1500 },
    { "kind": "screenshot", "label": "03-fleet-mobile" },
    { "kind": "press", "key": "Control+5", "label": "jump-library" },
    { "kind": "wait", "ms": 1500 },
    { "kind": "screenshot", "label": "04-library-mobile" },
    { "kind": "press", "key": "Control+6", "label": "jump-auditorium" },
    { "kind": "wait", "ms": 1500 },
    { "kind": "screenshot", "label": "05-auditorium-mobile" },
    { "kind": "press", "key": "Control+3", "label": "open-admin" },
    { "kind": "wait", "ms": 2000 },
    { "kind": "screenshot", "label": "06-admin-mobile" },
    { "kind": "press", "key": "Escape", "label": "close-admin" },
    { "kind": "wait", "ms": 500 },
    { "kind": "press", "key": "Control+1", "label": "back-to-chat" },
    { "kind": "wait", "ms": 500 },
    { "kind": "screenshot", "label": "07-final-mobile" }
  ]
}
