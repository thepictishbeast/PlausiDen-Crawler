{
  "name": "sacredvote-org",
  "description": "Read-only crawl of sacredvote.org marketing/public surface. BFS through every same-origin page, capture aria + screenshot + interactables. Does NOT submit forms.",
  "baseUrl": "https://sacredvote.org/",
  "viewport": { "w": 1280, "h": 900 },
  "steps": [
    { "kind": "goto", "url": "https://sacredvote.org/", "timeout": 30000, "label": "landing" },
    { "kind": "wait", "ms": 1500, "label": "settle" },
    { "kind": "screenshot", "label": "00-landing" },
    {
      "kind": "discover",
      "label": "anonymous-bfs",
      "url": "https://sacredvote.org/",
      "discover": {
        "maxPages": 80,
        "maxDepth": 4,
        "sameOrigin": true,
        "interactButtons": "never",
        "settleMs": 800,
        "navTimeoutMs": 25000,
        "denyPatterns": [
          "/api/",
          "/csp-report",
          "/logout",
          "/sign-?out",
          "\\.json$",
          "\\.xml$",
          "/submit",
          "/contact-submit"
        ]
      }
    }
  ]
}
